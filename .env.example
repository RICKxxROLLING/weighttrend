# Copy to ".env" and fill in. docker-compose reads this automatically.

# From the Withings developer dashboard (https://developer.withings.com/dashboard/)
WITHINGS_CLIENT_ID=your_client_id_here
WITHINGS_CLIENT_SECRET=your_client_secret_here

# Where Withings redirects after you authorize. Must EXACTLY match the
# "Callback URI" you set in the Withings dashboard.
# Examples:
#   http://localhost:8080/callback           (testing on the same machine)
#   http://192.168.1.50:8080/callback        (your Unraid server's LAN IP)
#   https://weight.yourdomain.com/callback   (behind a reverse proxy - recommended)
WITHINGS_REDIRECT_URI=http://localhost:8080/callback

# Random string used to sign session cookies. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-please

# Display units: kg or lb
UNITS=kg

# EWMA smoothing factor (0.1 ~ a 10-day window). Lower = smoother/slower.
EWMA_ALPHA=0.1

# How many recent days of trend to use for the goal-date projection.
PROJECTION_WINDOW_DAYS=30
